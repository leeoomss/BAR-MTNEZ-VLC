---
import { menus, condicionesMenus } from '../data/carta';
import { negocio } from '../data/negocio';
---

<section id="grupos" class="sobre-oscuro bg-tinta text-cal" aria-labelledby="titulo-grupos">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
    <div class="max-w-2xl">
      <p class="antetitulo">Menús para grupos</p>
      <h2 id="titulo-grupos" class="titular mt-3 text-[clamp(2.5rem,8vw,4rem)]">Para venir en grupo y compartirlo todo</h2>
      <p class="mt-5 text-cal/80">
        Dos menús cerrados para comidas y cenas de grupo, con la bebida incluida. Se reservan por teléfono.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {
        menus.map((m) => (
          <article class="flex flex-col rounded-[2rem] bg-cal p-6 text-tinta sm:p-9">
            <header class="flex items-start justify-between gap-4 border-b-2 border-tinta pb-5">
              <h3 class="font-display text-3xl font-bold uppercase leading-none sm:text-4xl">{m.nombre}</h3>
              <p class="grid shrink-0 place-items-center rounded-[50%] border-[3px] border-verde px-5 py-3 text-center leading-none">
                <span class="font-display text-3xl font-bold sm:text-4xl">{m.precio} €</span>
                <span class="mt-1 text-[0.6875rem] font-semibold uppercase tracking-wider text-gris">por persona</span>
              </p>
            </header>
            <div class="mt-2 flex-1 divide-y divide-tinta/10">
              {m.bloques.map((b) => (
                <div class="py-5">
                  <p class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <span class="font-display text-xl font-bold uppercase tracking-wide">{b.titulo}</span>
                    <span class="text-[0.8125rem] font-semibold text-botella">{b.regla}</span>
                  </p>
                  <ul class="mt-2 space-y-1.5 text-[0.9875rem]">
                    {b.platos.map((p) => (
                      <li class="flex gap-2.5">
                        <span class="mt-[0.6em] inline-block h-1.5 w-2 shrink-0 rounded-[50%] bg-verde" aria-hidden="true" />
                        {p}
                      </li>
                    ))}
                  </ul>
                  {b.nota && <p class="mt-3 rounded-xl bg-cal-2 px-3 py-2 text-sm font-medium">{b.nota}</p>}
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-10 grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
      <ul class="space-y-2 text-[0.9375rem] text-cal/85">
        {
          condicionesMenus.map((c) => (
            <li class="flex gap-2.5">
              <span class="mt-[0.55em] inline-block h-1.5 w-2 shrink-0 rounded-[50%] bg-ambar" aria-hidden="true" />
              {c}
            </li>
          ))
        }
      </ul>
      <a href={negocio.telefonoHref} class="btn btn-claro min-h-14 px-8 text-lg">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg>
        Llamar para reservar
      </a>
    </div>
  </div>
</section>
