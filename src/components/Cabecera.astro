---
import Logo from './Logo.astro';
import { negocio } from '../data/negocio';

const enlaces = [
  { href: '#carta', texto: 'Carta' },
  { href: '#grupos', texto: 'Grupos' },
  { href: '#horario', texto: 'Horario' },
  { href: '#donde', texto: 'Dónde' },
];
---

<header id="cabecera" class="sticky top-0 z-40 border-b border-transparent bg-cal/90 backdrop-blur-md transition-[border-color] duration-300">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="#inicio" class="shrink-0" aria-label="MTNEZ., ir al inicio">
      <Logo class="h-11 w-auto" titulo="" />
    </a>
    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-8 text-[0.9375rem] font-semibold">
        {
          enlaces.map((e) => (
            <li>
              <a href={e.href} class="enlace-nav">{e.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href={negocio.telefonoHref} class="btn btn-verde hidden min-h-11 px-5 text-[0.9375rem] md:inline-flex">
      Reservar · {negocio.telefono.replace('+34 ', '')}
    </a>
    <a href="#carta" class="btn btn-borde min-h-11 px-5 text-[0.9375rem] md:hidden">Carta</a>
  </div>
</header>

<style>
  .enlace-nav {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    padding-block: 0.25rem;
    transition: background-size 0.25s var(--ease-out-quint);
  }
  @media (hover: hover) {
    .enlace-nav:hover {
      background-size: 100% 2px;
    }
  }
  #cabecera[data-scrolled] {
    border-color: rgb(17 17 17 / 0.08);
  }
</style>

<script>
  const cab = document.getElementById('cabecera');
  const marca = () => cab?.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', marca, { passive: true });
  marca();
</script>
